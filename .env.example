# Copy to .env or export in your shell. NOTHING here is required: the core pipeline runs without any key.
# OPENAI_API_KEY=            # optional: enables --mode smart/quality. Or point to a file:  OPENAI_API_KEY_FILE=C:\secrets\openai.txt
# YOUTUBE_API_KEY=           # optional: YouTube live chat via the official Data API (your own free key)
# CLIPPER_JOBS=clipper-jobs  # where jobs live
# CLIPPER_MODELS=            # model cache (default ~/.cache/clipper)
# CLIPPER_OFFLINE=1          # never download models; features whose model is missing are skipped and reported
# CLIPPER_FFMPEG=            # path to ffmpeg if not on PATH
# CLIPPER_ENCODER=           # force an encoder (still test-encoded): h264_nvenc | h264_qsv | h264_amf | h264_videotoolbox | libx264
# CLIPPER_PRICE=0.15,0.60    # USD per 1M tokens (input,output) used for the cost report: CHECK current OpenAI pricing
# CLIPPER_MAX_HEAVY=1        # simultaneous heavy tasks (render/process) in the MCP/HTTP server
# CLIPPER_MIN_FREE_GB=2      # refuse to start with less free disk
# OLLAMA_URL=http://localhost:11434   OLLAMA_MODEL=qwen2.5:7b
